{
  "name": "inkstone-mdx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/runtime.mjs && vite --host 127.0.0.1",
    "build": "node scripts/runtime.mjs && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "bench": "node scripts/bench.mjs",
    "format": "prettier --write src scripts tests desktop *.js *.json *.html README.md docs/*.md .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests desktop *.js *.json *.html README.md docs/*.md .github/workflows/*.yml",
    "test:worker": "node scripts/check-worker.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "test:desktop": "playwright test --config playwright.desktop.config.js"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.3",
    "@mdx-js/mdx": "^3.1.1",
    "codemirror": "^6.0.2",
    "decode-named-character-reference": "^1.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "esbuild": "^0.25.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "prettier": "^3.10.1",
    "vite": "^7.2.2"
  },
  "description": "Local MDX editor with sandboxed project previews",
  "author": "Inkstone MDX contributors",
  "license": "MIT",
  "main": "desktop/main.mjs",
  "build": {
    "appId": "io.inkstone.mdx",
    "productName": "Inkstone MDX",
    "asar": true,
    "asarUnpack": [
      "node_modules/@esbuild/**",
      "node_modules/esbuild/**"
    ],
    "files": [
      "dist/**",
      "desktop/**",
      "src/preview-shared.jsx",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Inkstone MDX contributors"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
