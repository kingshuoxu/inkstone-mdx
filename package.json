{
  "name": "inkstone-mdx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/runtime.mjs && vite --host 127.0.0.1",
    "build": "node scripts/runtime.mjs && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "bench": "node scripts/bench.mjs",
    "format": "prettier --write src scripts tests *.js *.json *.html README.md docs/*.md .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests *.js *.json *.html README.md docs/*.md .github/workflows/*.yml",
    "test:worker": "node scripts/check-worker.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.3",
    "@mdx-js/mdx": "^3.1.1",
    "codemirror": "^6.0.2",
    "decode-named-character-reference": "^1.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.25.12",
    "prettier": "^3.10.1",
    "vite": "^7.2.2"
  }
}
